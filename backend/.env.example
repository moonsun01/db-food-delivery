PORT=4000
# json: DB 없이 실행 / mysql: 팀 MySQL 사용 / memory: 테스트용
STORAGE_MODE=json
SEED_SAMPLE_DATA=true
PAYMENT_MODE=mock
MOCK_PAYMENT_RESULT=success
SESSION_HOURS=8
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# npm.cmd run dev:setup으로 자동 생성. 실제 값은 공유하지 않습니다.
OPERATIONS_API_KEY=

# MySQL 사용 시 STORAGE_MODE=mysql, SEED_SAMPLE_DATA=false로 변경합니다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=""
DB_NAME=delivery_app
DB_RUNTIME_NAME=delivery_app_runtime
